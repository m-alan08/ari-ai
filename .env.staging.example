# Staging template — every value here is REQUIRED for APP_ENV=staging unless
# marked optional. `hackatl-preflight` refuses to boot without them.
# Copy to the staging secret store; NEVER commit real values.

APP_ENV=staging
LOG_LEVEL=info
LOG_FORMAT=json

# --- Anthropic (real key from the secret store; model enforced to Haiku 5.5) ---
ANTHROPIC_API_KEY=
AGENT_MODEL_OVERRIDES=
LLM_SERVER_FALLBACKS=false
LLM_MAX_TOKENS_PER_ASSESSMENT=400000
LLM_MAX_USD_PER_ASSESSMENT=10

# --- Control plane ---
API_BASE_URL=https://staging-api.example.com
FRONTEND_ORIGIN=https://staging-console.example.com
DATABASE_URL=postgresql://user:password@host:5432/hackatl
ARTIFACT_STORE_URI=file:///data/artifacts
SESSION_SECRET=

# --- GitHub App + OAuth (both required; see docs/deploy/RAILWAY_AND_GITHUB_APP.md) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_AUTO_COMMIT_AUTHORS=

# --- Workers (preflight --worker fails without all three) ---
RL_CHECKPOINT_PATH=
RL_CHECKPOINT_SHA256=
RL_TOPOLOGY_PATH=
WORKER_LEASE_S=60
SECURITY_SANDBOX=docker

# --- Operations surface ---
# Required: without it /api/v1/ops/status answers 404 in staging.
OPS_TOKEN=
# Recommended: critical-failure alerts (job dead/permanent failures).
ALERT_WEBHOOK_URL=
# Leave empty for the pilot; flags are off unless listed.
FEATURE_FLAGS=
