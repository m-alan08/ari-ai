# Copy to .env and fill in locally. NEVER commit .env.
# All values below are placeholders. Variables are documented in
# docs/18_INFRASTRUCTURE_AND_DEPLOYMENT.md.

# --- Environment ---
APP_ENV=development            # development | staging | production
LOG_LEVEL=info

# --- Anthropic ---
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-haiku-5-5         # default model for all agents (Claude Haiku 5.5)
ANTHROPIC_MODEL_FAST=replace-me          # optional cheaper model for triage/summaries
# Per-agent model overrides, e.g. scout=<model>,fortify=<model>
AGENT_MODEL_OVERRIDES=
LLM_MAX_TOKENS_PER_ASSESSMENT=400000
LLM_MAX_USD_PER_ASSESSMENT=10

# --- Backend ---
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://app:replace-me@localhost:5432/hackatl
# Optional migration-only role; the API and workers continue to use DATABASE_URL.
MIGRATION_DATABASE_URL=
ARTIFACT_STORE_URI=file://./artifacts    # later: s3://bucket/prefix
SESSION_SECRET=replace-me-with-random-64-bytes

# --- GitHub integration (GitHub App) ---
GITHUB_APP_ID=replace-me
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_OAUTH_CLIENT_ID=replace-me
GITHUB_OAUTH_CLIENT_SECRET=replace-me

# --- Sandbox ---
SANDBOX_RUNTIME=docker                   # docker | gvisor (future)
SANDBOX_DEFAULT_TIMEOUT_SECONDS=300
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_NETWORK_MODE=none                # none | target-only

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- RL ---
RL_DEVICE=cpu                            # cpu | cuda | mps
RL_RUNS_DIR=./rl-defense/runs

# --- Control plane (backend/README.md) ---
AUTH_DEV_LOGIN_ENABLED=false             # true only for local development (APP_ENV=development)
FRONTEND_ORIGIN=http://localhost:3000
ANTHROPIC_EFFORT=high                    # low | medium | high | xhigh | max
LLM_SERVER_FALLBACKS=true                # server-side refusal fallback on the Anthropic API
ORCHESTRATOR_FACTORY=security_agents.api:build_orchestrator
CODE_INTELLIGENCE_FACTORY=code_intelligence.api:build_service
WORKER_LEASE_S=60
# Execution reliability; 0 disables a limit (docs/architecture/execution-reliability.md)
JOB_MAX_RUNNING_PER_PROJECT=4
JOB_MAX_RUNNING_GLOBAL=0
JOB_MAX_PENDING_PER_PROJECT=1000
WORKER_RECONCILE_INTERVAL_S=30
# e.g. rl-defense/runs/protocol-v0/ddqn_seed0.pt
RL_CHECKPOINT_PATH=
# Required outside dev/test. SHA-256 from the committed manifest, e.g.
# rl-defense/results/protocol-v1/checkpoints/ddqn_seed0.manifest.json
RL_CHECKPOINT_SHA256=
# e.g. rl-defense/configs/topology/payments_lite.yaml
RL_TOPOLOGY_PATH=

# Optional per-commit author rollout (comma-separated GitHub logins or *).
# Empty (Railway default) skips per-commit full runs; enabled repos use legacy
# impact-gated, coalesced monitoring. Set * or a login list for per-commit full runs.
GITHUB_AUTO_COMMIT_AUTHORS=

# Shared project review quotas across every assessment trigger.
PROJECT_ASSESSMENTS_PER_HOUR=10
PROJECT_ASSESSMENTS_PER_DAY=50
ASSESSMENTS_USD_PER_DAY=50
# Production/staging and Railway enforce Haiku 5.5; model overrides are test/dev only.

# --- Operations (docs/deploy/PILOT_OPERATIONS.md) ---
# bearer token for GET /api/v1/ops/status; unset disables it outside dev/test
OPS_TOKEN=
# HTTPS webhook for critical-failure alerts (Slack-compatible {"text": ...})
ALERT_WEBHOOK_URL=
LOG_FORMAT=auto                       # auto | json | text (auto = json outside dev/test)
# comma-separated flags, off unless listed
FEATURE_FLAGS=

# --- Ops surface + storage maintenance (docs/deploy/POSTGRES_STORAGE.md) ---
# Bearer token for /api/v1/ops/* endpoints; unset disables them entirely.
OPS_API_TOKEN=
# Generic HTTPS webhook posted when storage crosses 70/80/90% of the volume.
OPS_ALERT_WEBHOOK_URL=
# Provisioned size of the Railway Postgres volume in bytes (dashboard value).
# 0 = unknown: reports still emit absolute usage, percentage alerts are skipped.
POSTGRES_VOLUME_BYTES=0
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_S=3600
# true = report what would be deleted without deleting. Set false after reviewing
# a report (or pass --apply to `python -m backend.maintenance apply`).
RETENTION_DRY_RUN=true
RETENTION_BATCH_LIMIT=5000
RETENTION_JOBS_DAYS=30
RETENTION_WEBHOOK_DELIVERIES_DAYS=90
RETENTION_MONITORING_EVENTS_DAYS=180
RETENTION_REASSESSMENT_REQUESTS_DAYS=180
RETENTION_RUNTIME_WINDOWS_DAYS=30
RETENTION_IDEMPOTENCY_DAYS=7
# Ready code-intelligence snapshots whose payload bytes are kept per repository.
RETENTION_SNAPSHOTS_PER_REPO=5
# Payloads younger than this are never pruned (protects in-flight work).
RETENTION_SNAPSHOT_GRACE_DAYS=7
# Payloads never marked ready (failed/abandoned indexing) pruned after N hours.
RETENTION_ORPHAN_GRACE_HOURS=24
# 0 = keep assessment transcripts/events forever (pilot evidence protection).
RETENTION_ASSESSMENT_DETAIL_DAYS=0
# refs/ari/* refs kept per bare clone under SECURITY_WORKDIR/repos.
RETENTION_CHECKOUT_REFS_KEEP=50
# Orphaned artifact files (no artifacts row) removed after N hours.
RETENTION_ORPHAN_ARTIFACT_HOURS=24
