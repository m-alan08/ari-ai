{
  "additionalProperties": false,
  "description": "Whether the decision's mapped commit resolved to an indexed snapshot.",
  "properties": {
    "commit_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit Sha"
    },
    "mapping_id": {
      "anyOf": [
        {
          "pattern": "^dcm_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapping Id"
    },
    "note": {
      "maxLength": 500,
      "title": "Note",
      "type": "string"
    },
    "repo_id": {
      "anyOf": [
        {
          "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repo Id"
    },
    "resolved": {
      "default": false,
      "title": "Resolved",
      "type": "boolean"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    }
  },
  "required": [
    "note"
  ],
  "title": "InvestigationSnapshotView",
  "type": "object"
}
