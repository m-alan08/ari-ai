{
  "$defs": {
    "ActionScore": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "noop",
            "raise_monitoring",
            "rate_limit",
            "isolate",
            "request_reassessment",
            "escalate_to_human",
            "block_principal",
            "block_principal_long",
            "block_top_principal_long"
          ],
          "title": "Action",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "enum": [
                "gateway",
                "api",
                "auth",
                "payments",
                "db"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Node"
        },
        "q_value": {
          "title": "Q Value",
          "type": "number"
        }
      },
      "required": [
        "action",
        "node",
        "q_value"
      ],
      "title": "ActionScore",
      "type": "object"
    },
    "AgentCapabilityClass": {
      "enum": [
        "investigative_readonly",
        "code_changing",
        "disruptive_scoped"
      ],
      "title": "AgentCapabilityClass",
      "type": "string"
    },
    "AgentExecutionView": {
      "additionalProperties": false,
      "description": "Recorded agent-loop outcome. Absent fields stay unknown; never invented.",
      "properties": {
        "confirmation": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmation"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "evidence_verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Verified"
        },
        "execution_integrity": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Integrity"
        },
        "execution_is_not_confirmation": {
          "const": true,
          "default": true,
          "title": "Execution Is Not Confirmation",
          "type": "boolean"
        },
        "hypothesis_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypothesis Count"
        },
        "independent_verification_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Independent Verification Id"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "llm_turns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Turns"
        },
        "model_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "output_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Artifact Id"
        },
        "predicted_probability": {
          "default": null,
          "title": "Predicted Probability",
          "type": "null"
        },
        "provider_mode": {
          "anyOf": [
            {
              "enum": [
                "fake",
                "live",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Mode"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "tool_call_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Count"
        },
        "transcript_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Artifact Id"
        },
        "typed_output": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typed Output"
        }
      },
      "title": "AgentExecutionView",
      "type": "object"
    },
    "AgentInvocationStatus": {
      "enum": [
        "eligible",
        "blocked",
        "queued",
        "skipped_no_mapping",
        "skipped_no_snapshot",
        "skipped_mode",
        "skipped_no_scope",
        "skipped_no_approval",
        "skipped_no_patch",
        "completed_unverified",
        "failed",
        "cancelled"
      ],
      "title": "AgentInvocationStatus",
      "type": "string"
    },
    "AgentName": {
      "enum": [
        "scout",
        "probe",
        "trace",
        "diagnose",
        "patch",
        "fortify",
        "verify",
        "reviewer"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "AnalystHandoff": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "anyOf": [
            {
              "pattern": "^app_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application Id"
        },
        "assigned_to": {
          "anyOf": [
            {
              "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned To"
        },
        "caveat": {
          "default": "An alert is not delivered until the provider confirms receipt. Confirmed and unverified remain distinct. LLM prose cannot confirm a threat.",
          "maxLength": 500,
          "title": "Caveat",
          "type": "string"
        },
        "confirmation": {
          "$ref": "#/$defs/ConfirmationState",
          "default": "unverified"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Created By",
          "type": "string"
        },
        "decision_id": {
          "pattern": "^frd_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Decision Id",
          "type": "string"
        },
        "delivery_attempted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Attempted At"
        },
        "delivery_confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Confirmed At"
        },
        "delivery_provider": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Provider"
        },
        "delivery_provider_message_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Provider Message Id"
        },
        "evidence_event_ids": {
          "items": {
            "pattern": "^evt_[0-9A-Za-z_\\-]{8,64}$",
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^ahl_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "recommended_actions": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Recommended Actions",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/AnalystHandoffState"
        },
        "summary": {
          "maxLength": 500,
          "title": "Summary",
          "type": "string"
        },
        "threat_confirmed": {
          "default": false,
          "title": "Threat Confirmed",
          "type": "boolean"
        },
        "title": {
          "maxLength": 500,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "decision_id",
        "state",
        "title",
        "summary",
        "created_by",
        "created_at"
      ],
      "title": "AnalystHandoff",
      "type": "object"
    },
    "AnalystHandoffState": {
      "enum": [
        "draft",
        "queued",
        "delivery_pending",
        "delivered",
        "delivery_failed",
        "acknowledged",
        "investigating",
        "confirmed",
        "unverified",
        "resolved",
        "cancelled"
      ],
      "title": "AnalystHandoffState",
      "type": "string"
    },
    "ApplicationVerification": {
      "enum": [
        "unverified",
        "ingest_seen",
        "token_revoked",
        "disconnected"
      ],
      "title": "ApplicationVerification",
      "type": "string"
    },
    "BlockedAgent": {
      "additionalProperties": false,
      "properties": {
        "capability_class": {
          "$ref": "#/$defs/AgentCapabilityClass"
        },
        "name": {
          "$ref": "#/$defs/AgentName"
        },
        "reason": {
          "maxLength": 500,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "name",
        "reason",
        "capability_class"
      ],
      "title": "BlockedAgent",
      "type": "object"
    },
    "CommitRange": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Sha"
        },
        "head_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Head Sha",
          "type": "string"
        }
      },
      "required": [
        "head_sha"
      ],
      "title": "CommitRange",
      "type": "object"
    },
    "ConfirmationState": {
      "description": "Confirmed vs unverified stay distinct. LLM prose cannot set confirmed.",
      "enum": [
        "unverified",
        "confirmed"
      ],
      "title": "ConfirmationState",
      "type": "string"
    },
    "ConnectedApplication": {
      "additionalProperties": false,
      "description": "Owner-registered staging app under watch. Never includes secrets.",
      "properties": {
        "control_channel_configured": {
          "default": false,
          "description": "True when a control channel exists; the HMAC secret is never returned",
          "title": "Control Channel Configured",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Created By",
          "type": "string"
        },
        "disconnected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disconnected At"
        },
        "environment": {
          "$ref": "#/$defs/StagingEnvironment"
        },
        "id": {
          "pattern": "^app_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "ingest_configured": {
          "description": "True when a non-revoked ingest token exists; the token itself is never returned",
          "title": "Ingest Configured",
          "type": "boolean"
        },
        "last_ingest_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Ingest At"
        },
        "name": {
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "shadow_mode": {
          "const": true,
          "default": true,
          "title": "Shadow Mode",
          "type": "boolean"
        },
        "verification": {
          "$ref": "#/$defs/ApplicationVerification"
        }
      },
      "required": [
        "id",
        "project_id",
        "name",
        "environment",
        "ingest_configured",
        "verification",
        "created_by",
        "created_at"
      ],
      "title": "ConnectedApplication",
      "type": "object"
    },
    "CorrelationConfidence": {
      "description": "Explicit correlation confidence. Never a probability. UNKNOWN without a mapping.",
      "enum": [
        "unknown",
        "none",
        "low",
        "medium"
      ],
      "title": "CorrelationConfidence",
      "type": "string"
    },
    "DeployCommitMapping": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "pattern": "^app_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Application Id",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Created By",
          "type": "string"
        },
        "deployed_at": {
          "format": "date-time",
          "title": "Deployed At",
          "type": "string"
        },
        "id": {
          "pattern": "^dcm_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "repo_id": {
          "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Repo Id",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        },
        "source": {
          "const": "owner_attested",
          "default": "owner_attested",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "application_id",
        "repo_id",
        "commit_sha",
        "deployed_at",
        "created_by",
        "created_at"
      ],
      "title": "DeployCommitMapping",
      "type": "object"
    },
    "EventSource": {
      "enum": [
        "github",
        "runtime",
        "internal",
        "advisory"
      ],
      "title": "EventSource",
      "type": "string"
    },
    "EventStatus": {
      "enum": [
        "received",
        "processing",
        "processed",
        "ignored",
        "failed"
      ],
      "title": "EventStatus",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "push",
        "pull_request",
        "log_anomaly",
        "assessment_completed",
        "advisory"
      ],
      "title": "EventType",
      "type": "string"
    },
    "EvidenceLifecycleState": {
      "description": "UI case states. Recommended is not executed. RL rec is never Executed.",
      "enum": [
        "observed",
        "suspected",
        "verified",
        "recommended",
        "authorized",
        "executed",
        "failed",
        "rolled_back"
      ],
      "title": "EvidenceLifecycleState",
      "type": "string"
    },
    "FirstResponderDecision": {
      "additionalProperties": false,
      "description": "Versioned decision record. Future RL must beat this baseline. No invented probabilities.",
      "properties": {
        "action": {
          "$ref": "#/$defs/OrchestratorAction"
        },
        "application_id": {
          "anyOf": [
            {
              "pattern": "^app_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application Id"
        },
        "auto_execute": {
          "const": false,
          "default": false,
          "title": "Auto Execute",
          "type": "boolean"
        },
        "blocked_agents": {
          "items": {
            "$ref": "#/$defs/BlockedAgent"
          },
          "title": "Blocked Agents",
          "type": "array"
        },
        "budget_usd_remaining": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Usd Remaining"
        },
        "cancel_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancel Reason"
        },
        "cancelled": {
          "default": false,
          "title": "Cancelled",
          "type": "boolean"
        },
        "caveat": {
          "default": "Deterministic first-responder decision. LLM prose is never proof of a confirmed threat. RL recommendations are not executed defense. AUTO-EXECUTE does not exist.",
          "maxLength": 500,
          "title": "Caveat",
          "type": "string"
        },
        "confirmation": {
          "$ref": "#/$defs/ConfirmationState",
          "default": "unverified"
        },
        "correlation": {
          "$ref": "#/$defs/RuntimeCodeCorrelation"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deadline_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline At"
        },
        "effective_mode": {
          "$ref": "#/$defs/FirstResponderIntent"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceLifecycleState"
        },
        "executed": {
          "const": false,
          "default": false,
          "title": "Executed",
          "type": "boolean"
        },
        "id": {
          "pattern": "^frd_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "incident_id": {
          "anyOf": [
            {
              "pattern": "^inc_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incident Id"
        },
        "intent_mode": {
          "$ref": "#/$defs/FirstResponderIntent"
        },
        "live_policy_decision_id": {
          "anyOf": [
            {
              "pattern": "^lpd_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Live Policy Decision Id"
        },
        "llm_prose_is_not_confirmation": {
          "const": true,
          "default": true,
          "title": "Llm Prose Is Not Confirmation",
          "type": "boolean"
        },
        "loop_count": {
          "default": 0,
          "minimum": 0,
          "title": "Loop Count",
          "type": "integer"
        },
        "orchestrator_version": {
          "default": "7a.1.1",
          "maxLength": 500,
          "title": "Orchestrator Version",
          "type": "string"
        },
        "outcome_label": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human later; never auto-assigned as an RL label",
          "title": "Outcome Label"
        },
        "predicted_probability": {
          "default": null,
          "title": "Predicted Probability",
          "type": "null"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "q_values": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ActionScore"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Copied only when frozen v6 inference actually ran",
          "title": "Q Values"
        },
        "recommended_control": {
          "anyOf": [
            {
              "enum": [
                "noop",
                "raise_monitoring",
                "rate_limit",
                "isolate",
                "request_reassessment",
                "escalate_to_human",
                "block_principal",
