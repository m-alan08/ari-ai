{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "diff",
        "sealed_diff",
        "log",
        "test_report",
        "webhook_payload",
        "llm_transcript",
        "tool_output",
        "report",
        "rl_eval_summary",
        "rl_checkpoint",
        "other"
      ],
      "title": "ArtifactKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactKind"
    },
    "media_type": {
      "default": "application/octet-stream",
      "maxLength": 500,
      "title": "Media Type",
      "type": "string"
    },
    "redacted": {
      "default": true,
      "description": "True when secrets were scrubbed before storage",
      "title": "Redacted",
      "type": "boolean"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "kind",
    "sha256",
    "size_bytes"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
