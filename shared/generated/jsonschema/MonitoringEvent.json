{
  "$defs": {
    "CommitRange": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Sha"
        },
        "head_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Head Sha",
          "type": "string"
        }
      },
      "required": [
        "head_sha"
      ],
      "title": "CommitRange",
      "type": "object"
    },
    "EventSource": {
      "enum": [
        "github",
        "runtime",
        "internal",
        "advisory"
      ],
      "title": "EventSource",
      "type": "string"
    },
    "EventStatus": {
      "enum": [
        "received",
        "processing",
        "processed",
        "ignored",
        "failed"
      ],
      "title": "EventStatus",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "push",
        "pull_request",
        "log_anomaly",
        "assessment_completed",
        "advisory"
      ],
      "title": "EventType",
      "type": "string"
    },
    "ImpactResolution": {
      "enum": [
        "symbol",
        "path_only"
      ],
      "title": "ImpactResolution",
      "type": "string"
    },
    "ImpactSet": {
      "additionalProperties": false,
      "description": "What a commit range touches (docs/10 'Correlate').",
      "properties": {
        "base_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Sha"
        },
        "base_snapshot_id": {
          "anyOf": [
            {
              "pattern": "^snp_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Snapshot Id"
        },
        "changed_paths": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "title": "Changed Paths",
          "type": "array"
        },
        "expectations": {
          "items": {
            "pattern": "^exp_[0-9A-Za-z_\\-]{8,64}$",
            "type": "string"
          },
          "title": "Expectations",
          "type": "array"
        },
        "findings": {
          "items": {
            "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "head_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Head Sha",
          "type": "string"
        },
        "head_snapshot_id": {
          "anyOf": [
            {
              "pattern": "^snp_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Head Snapshot Id"
        },
        "regression_tests": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Regression Tests",
          "type": "array"
        },
        "repo_id": {
          "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Repo Id",
          "type": "string"
        },
        "resolution": {
          "$ref": "#/$defs/ImpactResolution"
        },
        "symbols": {
          "items": {
            "pattern": "^sym_[0-9A-Za-z_\\-]{8,64}$",
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        }
      },
      "required": [
        "repo_id",
        "head_sha",
        "resolution"
      ],
      "title": "ImpactSet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "commit_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommitRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dedupe_key": {
      "maxLength": 500,
      "title": "Dedupe Key",
      "type": "string"
    },
    "id": {
      "pattern": "^evt_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "impact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImpactSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload Artifact Id"
    },
    "pr_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pr Number"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Project Id",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "ref": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "git ref, e.g. refs/heads/main",
      "title": "Ref"
    },
    "repo_id": {
      "anyOf": [
        {
          "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repo Id"
    },
    "simulated": {
      "default": false,
      "description": "True for replayed/fixture events; UI must label them",
      "title": "Simulated",
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/EventSource"
    },
    "status": {
      "$ref": "#/$defs/EventStatus"
    },
    "status_reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Reason"
    },
    "test_event": {
      "default": false,
      "description": "True for owner-authorized onboarding test events. They traverse the real authenticated ingest channel (simulated stays False) but customer-facing views must label them unmistakably as tests.",
      "title": "Test Event",
      "type": "boolean"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    }
  },
  "required": [
    "id",
    "project_id",
    "source",
    "type",
    "occurred_at",
    "received_at",
    "dedupe_key",
    "status"
  ],
  "title": "MonitoringEvent",
  "type": "object"
}
