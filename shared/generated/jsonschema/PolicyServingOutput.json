{
  "$defs": {
    "ActionScore": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "noop",
            "raise_monitoring",
            "rate_limit",
            "isolate",
            "request_reassessment",
            "escalate_to_human",
            "block_principal",
            "block_principal_long",
            "block_top_principal_long"
          ],
          "title": "Action",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "enum": [
                "gateway",
                "api",
                "auth",
                "payments",
                "db"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Node"
        },
        "q_value": {
          "title": "Q Value",
          "type": "number"
        }
      },
      "required": [
        "action",
        "node",
        "q_value"
      ],
      "title": "ActionScore",
      "type": "object"
    },
    "InferenceStatus": {
      "description": "Whether frozen v6 inference ran. Q-values exist only when ``ran``.",
      "enum": [
        "ran",
        "skipped_quiet_window",
        "skipped_incomplete",
        "skipped_stale",
        "skipped_source",
        "skipped_unavailable",
        "skipped_schema",
        "skipped_mask",
        "skipped_authorization",
        "skipped_target"
      ],
      "title": "InferenceStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Stable serving contract for a future approved policy. Missing fields stay missing.",
  "properties": {
    "abstention_reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstention Reason"
    },
    "action": {
      "anyOf": [
        {
          "enum": [
            "noop",
            "raise_monitoring",
            "rate_limit",
            "isolate",
            "request_reassessment",
            "escalate_to_human",
            "block_principal",
            "block_principal_long",
            "block_top_principal_long"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "action_mask_valid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Mask Valid"
    },
    "auto_served_unapproved_checkpoint": {
      "const": false,
      "default": false,
      "title": "Auto Served Unapproved Checkpoint",
      "type": "boolean"
    },
    "checkpoint_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Sha256"
    },
    "eval_bundle_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eval Bundle Sha256"
    },
    "feature_mapping_note": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feature Mapping Note"
    },
    "feature_schema_ok": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feature Schema Ok"
    },
    "freshness_ok": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freshness Ok"
    },
    "inference_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/InferenceStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "node": {
      "anyOf": [
        {
          "enum": [
            "gateway",
            "api",
            "auth",
            "payments",
            "db"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Node"
    },
    "observation": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation"
    },
    "observation_complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Complete"
    },
    "observation_dim": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Dim"
    },
    "policy_version": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Version"
    },
    "principal_targets": {
      "anyOf": [
        {
          "items": {
            "description": "Pseudonymous principal reference chosen by the reporter (e.g. an HMAC of its user id under a key the platform never sees); never an email or raw id",
            "pattern": "^prn_[A-Za-z0-9_-]{4,64}$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Principal Targets"
    },
    "q_margin": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Q Margin"
    },
    "q_values_are_not_probabilities": {
      "const": true,
      "default": true,
      "title": "Q Values Are Not Probabilities",
      "type": "boolean"
    },
    "top_actions": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ActionScore"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Top Actions"
    },
    "trained_commit_sha": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trained Commit Sha"
    },
    "uncertainty": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty"
    }
  },
  "title": "PolicyServingOutput",
  "type": "object"
}
