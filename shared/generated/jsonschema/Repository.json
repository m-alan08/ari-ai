{
  "$defs": {
    "RepoProvider": {
      "enum": [
        "github"
      ],
      "title": "RepoProvider",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "automatic_assessments": {
      "default": false,
      "title": "Automatic Assessments",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "default_branch": {
      "default": "main",
      "maxLength": 500,
      "title": "Default Branch",
      "type": "string"
    },
    "disconnected_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disconnected At"
    },
    "full_name": {
      "pattern": "^[A-Za-z0-9_.\\-]+/[A-Za-z0-9_.\\-]+$",
      "title": "Full Name",
      "type": "string"
    },
    "id": {
      "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "installation_id": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Installation Id"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Project Id",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/RepoProvider",
      "default": "github"
    }
  },
  "required": [
    "id",
    "project_id",
    "full_name",
    "created_at"
  ],
  "title": "Repository",
  "type": "object"
}
